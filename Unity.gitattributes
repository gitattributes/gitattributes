# Define macros (only works in top-level gitattributes files)
[attr]lfs               -text filter=lfs diff=lfs merge=lfs
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        eol=lf linguist-language=yaml merge=unityyamlmerge

# Unity source files
*.cg                    text linguist-language=hlsl
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.glslinc               text linguist-language=glsl
*.hlsl                  text
*.raytrace              text linguist-language=hlsl
*.shader                text

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.graphicsstate         unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity web template files
*.css                   text diff=css
*.html                  text diff=html
*.js                    text
*.webmanifest           text

# Unity UI Toolkit files
*.tss                   text linguist-language=css diff=css
*.uss                   text linguist-language=css diff=css
*.uxml                  text linguist-language=xml linguist-detectable
*.xsd                   text linguist-generated

